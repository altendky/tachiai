<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:testOnly="${localInspectionTestOnly}">
        <service
            android:name=".provider.abema.account.AbemaRenewalProbeService"
            android:exported="false"
            android:process=":abema_approval_browser" />
        <activity
            android:name=".feature.diagnostic.InspectionControlActivity"
            android:theme="@style/Theme.Tachiai.Prototype"
            android:enabled="${localInspectionEnabled}"
            android:exported="true" />
        <activity
            android:name=".feature.diagnostic.AbemaCachedHelperActivity"
            android:exported="true"
            android:process=":abema_cached_helper" />
        <activity
            android:name=".feature.diagnostic.AbemaEpisodeObservationActivity"
            android:theme="@style/Theme.Tachiai.Prototype"
            android:exported="false"
            android:process=":prototype_cached_player" />
        <activity
            android:name=".feature.diagnostic.AbemaGuestBootstrapActivity"
            android:exported="true"
            android:process=":abema_guest_bootstrap" />
        <activity
            android:name=".feature.presentation.FullPagePrototypeActivity"
            android:theme="@style/Theme.Tachiai.Prototype"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:process=":prototype_player" />
        <activity
            android:name=".feature.diagnostic.NativePairViewerActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize"
            android:process=":abema_opaque_broker" />
        <activity
            android:name=".feature.diagnostic.AbemaOpaqueBrokerActivity"
            android:exported="true"
            android:process=":abema_opaque_broker" />
        <activity
            android:name=".feature.diagnostic.AbemaNativeRequestActivity"
            android:exported="true"
            android:process=":abema_request_probe" />
        <activity
            android:name=".feature.diagnostic.AbemaInspectionActivity"
            android:exported="true"
            android:process=":abema_inspection" />
    </application>
</manifest>
