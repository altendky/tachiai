@@ -618,0 +619,27 @@
+#ifdef TACHIAI_CERTIFICATE_ONLY
+	/* Modified by Tachiai, 2026-10-09: reject interactive/host-scan XML
+	 * before parsing can populate script, browser, or POST state. */
+	if (strlen(response) > 65536 || xml_doc->intSubset || xml_doc->extSubset) {
+		ret = -EPERM;
+		goto out;
+	}
+	{
+		xmlNode *node = xmlDocGetRootElement(xml_doc);
+		while (node) {
+			if (node->type == XML_ELEMENT_NODE &&
+			    (xmlnode_is_named(node, "form") ||
+			     !strncmp((const char *)node->name, "sso", 3) ||
+			     !strncmp((const char *)node->name, "csd", 3) ||
+			     !strncmp((const char *)node->name, "host-scan", 9) ||
+			     xmlnode_is_named(node, "authentication-complete"))) {
+				ret = -EPERM;
+				goto out;
+			}
+			if (node->children) { node = node->children; continue; }
+			while (node && !node->next) node = node->parent;
+			if (node) node = node->next;
+		}
+	}
+#endif
