+static int cstp_readline(struct openconnect_info *vpninfo, char *buf, size_t size,
+			 unsigned *bytes, unsigned *count)
+{
+#ifdef TACHIAI_CERTIFICATE_ONLY
+	/* Modified by Tachiai, 2026-10-09: immutable, bounded CSTP metadata.
+	 * Distinguish a real empty CRLF line from early TLS EOF. */
+	size_t pos = 0;
+	if (++*count > 64)
+		return -E2BIG;
+	for (;;) {
+		char c;
+		int result = vpninfo->ssl_read(vpninfo, &c, 1);
+		if (result <= 0)
+			return result ? result : -EIO;
+		if (++*bytes > 8192 || pos >= 1024 || pos >= size - 1)
+			return -E2BIG;
+		if (!c || (!pos && (c == ' ' || c == '\t')))
+			return -EINVAL;
+		if (c == '\n') {
+			if (!pos || buf[pos - 1] != '\r')
+				return -EINVAL;
+			buf[pos - 1] = 0;
+			return pos - 1;
+		}
+		buf[pos++] = c;
+	}
+#else
+	(void)bytes;
+	(void)count;
+	return vpninfo->ssl_gets(vpninfo, buf, size);
+#endif
+}
