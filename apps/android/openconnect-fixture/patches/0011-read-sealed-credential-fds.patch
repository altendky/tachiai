+/* Modified by Tachiai, 2026-10-09: clear temporary PEM copies, including keys. */
+static void clear_loaded_datum(gnutls_datum_t *datum)
+{
+#ifdef TACHIAI_CERTIFICATE_ONLY
+	if (datum->data)
+		clear_mem(datum->data, datum->size + 1);
+#endif
+	gnutls_free(datum->data);
+	datum->data = NULL;
+	datum->size = 0;
+}
+
 static int load_datum(struct openconnect_info *vpninfo,
 		      gnutls_datum_t *datum, const char *fname)
 {
 	struct stat st;
 	int fd;
 
+#ifdef TACHIAI_CERTIFICATE_ONLY
+	/* Modified by Tachiai, 2026-10-09: borrow only the adapter's sealed FD.
+	 * Never reopen procfs or fall back to paths, keystores or host files.
+	 * pread preserves the offset across auth-to-CSTP credential reload. */
+	const char prefix[] = "tachiai-sealed-fd:";
+	const char *digit;
+	int seals, required = F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL;
+	size_t used = 0;
+	(void)vpninfo;
+	datum->data = NULL;
+	datum->size = 0;
+	if (!fname || strncmp(fname, prefix, sizeof(prefix) - 1))
+		return -EINVAL;
+	digit = fname + sizeof(prefix) - 1;
+	if (!*digit || (*digit == '0' && digit[1]))
+		return -EINVAL;
+	fd = 0;
+	for (; *digit; digit++) {
+		if (*digit < '0' || *digit > '9' || fd > (INT_MAX - (*digit - '0')) / 10)
+			return -EINVAL;
+		fd = fd * 10 + (*digit - '0');
+	}
+	if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size <= 0 || st.st_size > 8192)
+		return -EINVAL;
+	seals = fcntl(fd, F_GET_SEALS);
+	if (seals < 0 || (seals & required) != required)
+		return -EINVAL;
+	datum->size = (unsigned)st.st_size;
+	datum->data = gnutls_malloc(datum->size + 1);
+	if (!datum->data)
+		return -ENOMEM;
+	while (used < datum->size) {
+		ssize_t count = pread(fd, datum->data + used, datum->size - used, (off_t)used);
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count <= 0) {
+			clear_loaded_datum(datum);
+			return -EIO;
+		}
+		used += (size_t)count;
+	}
+	datum->data[datum->size] = 0;
+	return 0;
+#else
+
 #ifdef ANDROID_KEYSTORE
 	if (!strncmp(fname, "keystore:", 9)) {
 		int len;
@@ -470,6 +531,7 @@
 	datum->data[st.st_size] = 0;
 	close(fd);
 	return 0;
+#endif
 }
 
