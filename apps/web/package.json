{
  "name": "@tachiai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "bash ../../scripts/build-web-core.sh && node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "probe:abema": "node scripts/probe-abema.mjs",
    "probe:abema:backend": "uv run scripts/abema-backend-bootstrap.py",
    "probe:twitch": "node scripts/probe-twitch.mjs",
    "test:twitch:offline": "playwright test --config playwright.twitch-offline.config.ts",
    "test:twitch:owned": "playwright test --config playwright.twitch-owned.config.ts",
    "test:twitch:media": "playwright test --config playwright.twitch-media.config.ts && node --test ../../scripts/tests/web-twitch-runner-signals.test.mjs",
    "test:abema:local": "playwright test --config playwright.abema.config.ts",
    "test": "playwright test"
  },
  "dependencies": {
    "shaka-player": "5.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
