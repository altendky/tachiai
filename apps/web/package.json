{
  "name": "@tachiai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "bash ../../scripts/build-web-core.sh && bash ../../scripts/build-web-fixture-ffmpeg.sh && node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:owned-mixed": "node scripts/owned-mixed-test-server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "probe:abema": "node scripts/probe-abema.mjs",
    "probe:abema:backend": "uv run scripts/abema-backend-bootstrap.py",
    "probe:twitch": "node scripts/probe-twitch.mjs",
    "test:twitch:offline": "playwright test --config playwright.twitch-offline.config.ts",
    "test:twitch:owned": "playwright test --config playwright.twitch-owned.config.ts",
    "test:twitch:pair": "playwright test --config playwright.twitch-pair.config.ts",
    "test:twitch:media": "playwright test --config playwright.twitch-media.config.ts && node --test ../../scripts/tests/web-twitch-runner-signals.test.mjs ../../scripts/tests/web-twitch-browser-failures.test.mjs",
    "test:abema:local": "playwright test --config playwright.abema.config.ts",
    "test:abema:protected": "playwright test --config playwright.abema-protected.config.ts",
    "test:owned-mixed": "playwright test --config playwright.owned-mixed.config.ts",
    "test:provider:frame": "playwright test --config playwright.abema-provider-frame.config.ts",
    "test:provider:runtime": "playwright test --config playwright.provider-runtime.config.ts",
    "test:provider:pair": "playwright test --config playwright.provider-pair.config.ts",
    "test": "playwright test"
  },
  "dependencies": {
    "shaka-player": "5.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
